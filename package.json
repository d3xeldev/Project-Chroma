{
    "name": "project-chroma",
    "private": true,
    "workspaces": {
        "packages": [
            "apps/*",
            "packages/*"
        ],
        "catalog": {
            "@tabler/icons-react": "^3.44.0",
            "@types/node": "^25.9.1",
            "@types/react": "^19.2.15",
            "@types/react-dom": "^19.2.3",
            "react": "^19.2.6",
            "react-dom": "^19.2.6",
            "sonner": "^2.0.7",
            "tailwindcss": "^4.3.0",
            "tw-animate-css": "^1.4.0",
            "typescript": "^6.0.3",
            "vitest": "^4.1.7"
        }
    },
    "type": "module",
    "scripts": {
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=@project-chroma/web",
        "start": "turbo run start --filter=@project-chroma/desktop",
        "preview:web": "turbo run preview --filter=@project-chroma/web",
        "build": "turbo run build",
        "build:all": "turbo run build bundle:binaries --filter=@project-chroma/desktop --filter=@project-chroma/web",
        "lint": "oxlint",
        "test": "turbo run test",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "package": "turbo run package --filter=@project-chroma/desktop",
        "release": "turbo run release --filter=@project-chroma/desktop",
        "typecheck": "turbo run typecheck"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "oxfmt": "^0.51.0",
        "oxlint": "^1.66.0",
        "turbo": "^2.9.14"
    },
    "engines": {
        "bun": "^1.3.4",
        "node": "^25.9.1"
    },
    "packageManager": "bun@1.3.4"
}
