{
    "name": "luma",
    "private": true,
    "type": "module",
    "scripts": {
        "start:desktop": "pnpm --filter @luma/desktop start",
        "dev": "pnpm --filter @luma/desktop dev",
        "dev:web": "pnpm --filter @luma/web dev",
        "build": "pnpm -r --if-present --filter './apps/*' --filter './packages/*' build",
        "build:desktop": "pnpm --filter @recall/desktop build && pnpm --filter @recall/web build",
        "typecheck": "pnpm -r --if-present --workspace-concurrency=2",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check",
        "test": "pnpm -r --if-present test",
        "lint": "oxlint --disable-nested-config --report-unused-disable-directives",
        "lint:fix": "oxlint --fix --disable-nested-config --report-unused-disable-directives",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "dist:desktop": "node scripts/build-artifact.ts",
        "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": "^24"
    },
    "packageManager": "pnpm@12.5.1"
}
