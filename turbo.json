{
    "$schema": "https://turborepo.dev/schema.json",
    "globalDependencies": ["tsconfig.json"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "dist-electron/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": [],
            "cache": false
        },
        "typecheck": {
            "dependsOn": ["^typecheck"],
            "outputs": [],
            "cache": false
        }
    }
}
