{
    "name": "@luma/desktop",
    "version": "0.1.0",
    "private": true,
    "description": "Luma's desktop application",
    "author": "d3xeldev",
    "type": "module",
    "main": "dist-electron/main.cjs",
    "scripts": {
        "start": "node scripts/start-electron.mjs",
        "bundle:binaries": "node scripts/bundle-binaries.mjs",
        "build": "vite build --mode main && vite build --mode preload",
        "package": "electron-builder --publish never",
        "release": "electron-builder --publish always",
        "rebuild": "pnpm run rebuild:electron && pnpm run rebuild:sharp",
        "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
        "rebuild:sharp": "cd ./node_modules/sharp && pnpm run build",
        "ensure:electron": "node scripts/ensure-electron-runtime.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@luma/contracts": "workspace:*",
        "@luma/shared": "workspace:*",
        "better-sqlite3": "^12.5.0",
        "effect": "catalog:",
        "electron-updater": "^6.6.2",
        "piscina": "^5.2.0",
        "sharp": "^0.35.3",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.0.1",
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "@ffprobe-installer/ffprobe": "^2.1.2",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "catalog:",
        "electron": "^39.2.7",
        "electron-builder": "^26.15.3",
        "node-addon-api": "^8.9.2",
        "node-gyp": "^13.0.2",
        "tsdown": "^0.22.0",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "build": {
        "asar": true,
        "extraResources": [
            {
                "from": "resources/bin",
                "to": "bin",
                "filter": [
                    "**/*"
                ]
            }
        ]
    },
    "productName": "Luma"
}
